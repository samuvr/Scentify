# Postgres alojado (Neon). Cadena con sslmode=require.
DATABASE_URL="postgresql://usuario:password@ep-xxxx.eu-central-1.aws.neon.tech/scentify?sslmode=require"

# Primer usuario (el tuyo): se siembra con este id, correo y contrasena.
# Sin SCENTIFY_USER_PASSWORD el usuario se crea sin acceso posible.
# El correo se guarda siempre en minusculas.
SCENTIFY_USER_ID="00000000-0000-0000-0000-000000000001"
SCENTIFY_USER_EMAIL="yo@ejemplo.com"
SCENTIFY_USER_PASSWORD="cambia-esto"

# Clave para la autenticacion simple por cookie firmada (seccion 2).
AUTH_SECRET="cambia-esto-por-32-bytes-aleatorios"

# Codigo para que otras personas se creen cuenta en /registro. Vacio o sin
# definir, el registro esta cerrado. Pasalo como /registro?codigo=...
SCENTIFY_CODIGO_INVITACION=""

# Recordatorio diario (seccion 10.4). Genera el par con:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:yo@ejemplo.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# En Vercel solo migra el despliegue de produccion. Ponlo a 1 en el entorno
# Preview solo si las previews tienen su propia base (rama de Neon).
# SCENTIFY_MIGRAR_EN_PREVIEW="1"

# Protege /api/cron/recordatorio. Vercel lo manda como Bearer en sus crons.
CRON_SECRET=""

# Asistente (Mas > Asistente) y contextos sugeridos al dar de alta un perfume.
# Clave de la API de Claude; sin ella el asistente explica que falta y los
# contextos se marcan a mano. El modelo es opcional: por defecto, claude-opus-5-5.
ANTHROPIC_API_KEY=""
# SCENTIFY_ASISTENTE_MODELO="claude-opus-5-5"

# Copia automatica antes de migrar (opcional). Con las dos, cada despliegue
# que trae migraciones crea antes una rama de Neon «antes-de-…» con la base tal
# como estaba, y conserva las tres ultimas. La clave se crea en Neon → Account
# settings → API keys; el id del proyecto esta en Settings del proyecto.
# NEON_API_KEY=""
# NEON_PROJECT_ID=""
# Si la base no esta en la rama por defecto del proyecto, su id:
# NEON_BRANCH_ID=""
