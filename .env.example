# Postgres alojado (Neon). Cadena con sslmode=require.
DATABASE_URL="postgresql://usuario:password@ep-xxxx.eu-central-1.aws.neon.tech/scentify?sslmode=require"

# Primer usuario (el tuyo): se siembra con este id, correo y contrasena.
# Sin SCENTIFY_USER_PASSWORD el usuario se crea sin acceso posible.
# El correo se guarda siempre en minusculas.
SCENTIFY_USER_ID="00000000-0000-0000-0000-000000000001"
SCENTIFY_USER_EMAIL="yo@ejemplo.com"
SCENTIFY_USER_PASSWORD="cambia-esto"

# Clave para la autenticacion simple por cookie firmada (seccion 2).
AUTH_SECRET="cambia-esto-por-32-bytes-aleatorios"

# Codigo para que otras personas se creen cuenta en /registro. Vacio o sin
# definir, el registro esta cerrado. Pasalo como /registro?codigo=...
SCENTIFY_CODIGO_INVITACION=""

# Recordatorio diario (seccion 10.4). Genera el par con:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:yo@ejemplo.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Protege /api/cron/recordatorio. Vercel lo manda como Bearer en sus crons.
CRON_SECRET=""
