# Postgres alojado (Neon). Cadena con sslmode=require.
DATABASE_URL="postgresql://usuario:password@ep-xxxx.eu-central-1.aws.neon.tech/scentify?sslmode=require"

# Usuario unico del MVP: se siembra con este id y este correo.
SCENTIFY_USER_ID="00000000-0000-0000-0000-000000000001"
SCENTIFY_USER_EMAIL="yo@ejemplo.com"

# Clave para la autenticacion simple por cookie firmada (seccion 2).
AUTH_SECRET="cambia-esto-por-32-bytes-aleatorios"
